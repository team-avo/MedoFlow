// Cloudflare Pages "front door" (zero-cost clinic addresses, ADR 0005).
// Production (branch `medoflow`) serves https://medoflow.pages.dev; every other
// branch deployment serves https://<clinic>.medoflow.pages.dev. Both hand each
// request to the app Worker over a service binding. Deployed by
// .github/workflows/front-door.yml and front-door-all.yml, not by CI / Deploy.
//
// This must be a .jsonc file: wrangler looks for wrangler.jsonc in every parent
// folder before it looks for wrangler.toml, so a .toml here would lose to the
// app's own frontend/wrangler.jsonc.
{
  "name": "medoflow",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",

  // The app address (production) passes every request to the app Worker.
  "services": [{ "binding": "APP", "service": "medoflow-web" }],

  "env": {
    // Every clinic address (a branch = a "preview" deployment) needs the same link.
    // Keep this block: Pages does not copy `services` to previews by itself.
    "preview": {
      "services": [{ "binding": "APP", "service": "medoflow-web" }],
    },
  },
}
