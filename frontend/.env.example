NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: IANA time zone for appointment / slot times in the UI
# (e.g. America/Los_Angeles). Unset = the viewer's system time zone.
# NEXT_PUBLIC_DISPLAY_TIMEZONE=

# ─── Clinic websites (Component 8) ──────────────────────────────────────────
# Root domain clinic subdomains live under (<clinic>.<root>). Leave empty until
# the wildcard DNS is live; sites are then reachable at <app>/s/<slug>.
# Local development: localhost  →  http://<clinic-slug>.localhost:3000
NEXT_PUBLIC_SITE_ROOT_DOMAIN=localhost
# Hosts that serve the dashboard app (comma-separated, *.suffix allowed).
# Default when empty: <root>, app.<root>, 127.0.0.1, *.workers.dev
NEXT_PUBLIC_APP_HOSTS=
# The app's own origin: staff URLs opened on a clinic host redirect here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
