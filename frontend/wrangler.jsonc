// MedoFlow frontend (Next.js 14) on Cloudflare Workers via @opennextjs/cloudflare.
// Build + deploy: `pnpm run cf:deploy`. NEXT_PUBLIC_* values are inlined at build
// time from the build environment (CI sets NEXT_PUBLIC_API_URL from the BACKEND_URL repo variable).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medoflow-web",
  "account_id": "523c0186a1808be62e718907053c513b",
  "main": "cf-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "medoflow-web" }],
  // Component 8: medoflow.com on this Worker (arh-agent-docs/medoflow-com-domain-migration-guide.md).
  // The Custom Domain binds the apex (Cloudflare creates its DNS record + cert);
  // the wildcard route serves every <label>.medoflow.com from the same Worker, so
  // no per-clinic Pages deploy is needed. api.medoflow.com stays DNS-only (grey),
  // so the Worker never runs for it. These bind only once the medoflow.com zone is
  // active in this account and the deploy token has Zone Read + Workers Routes Edit.
  "routes": [
    { "pattern": "medoflow.com", "custom_domain": true },
    { "pattern": "*.medoflow.com/*", "zone_name": "medoflow.com" }
  ]
}
