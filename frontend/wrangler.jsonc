// MedoFlow frontend (Next.js 14) on Cloudflare Workers via @opennextjs/cloudflare.
// Build + deploy: `pnpm run cf:deploy`. NEXT_PUBLIC_* values are inlined at build
// time from the build environment (CI sets NEXT_PUBLIC_API_URL from the BACKEND_URL repo variable).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medoflow-web",
  "account_id": "523c0186a1808be62e718907053c513b",
  "main": "cf-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "medoflow-web" }],
  // Component 8: medoflow.com on this Worker (arh-agent-docs/medoflow-com-domain-migration-guide.md).
  // Both are zone ROUTES, not custom domains: a route attaches the Worker to an
  // existing proxied (orange) DNS record and does not try to manage DNS, so it
  // works when the apex already has a record (a custom_domain refuses that with
  // Cloudflare error 100117). The apex route also intercepts apex requests before
  // whatever origin the apex A/AAAA record points at, so any leftover apex->www
  // forwarding stops. The apex and the `*` wildcard each need a proxied DNS record
  // (e.g. AAAA 100::) in the zone. api.medoflow.com stays DNS-only (grey), so the
  // Worker never runs for it. These bind only once the medoflow.com zone is active
  // in this account and the deploy token has Zone Read + Workers Routes Edit.
  "routes": [
    { "pattern": "medoflow.com/*", "zone_name": "medoflow.com" },
    { "pattern": "*.medoflow.com/*", "zone_name": "medoflow.com" }
  ]
}
