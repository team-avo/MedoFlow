model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  itemType  CartItemType
  quantity  Int          @default(1)
  unitPrice Decimal      @db.Decimal(10, 2)

  serviceId    String?
  productId    String?
  packageId    String?
  membershipId String?

  appointmentId String? @unique

  /// B5.3 provenance: set when the item came from a provider-confirmed Rx→Cart proposal.
  rxOrderLineId          String?                  @unique
  prescribedByProviderId String?
  patientDecision        CartItemPatientDecision?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rxOrderLine  RxOrderLine? @relation(fields: [rxOrderLineId], references: [id], onDelete: SetNull)
  prescribedBy Provider?    @relation("CartItemPrescribedBy", fields: [prescribedByProviderId], references: [id], onDelete: SetNull)
