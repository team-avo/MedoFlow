  provider    Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem     @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  rule        CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([providerId])
  @@index([invoiceId])
  @@index([status])
  @@index([earnedAt])
}

// ────────────────────────────────────────────────────────────────────────
// Voice Agent (AI Front Desk)
//
// Per-clinic AI receptionist that answers the phone. Configured by the
// clinic owner, executed via OpenAI Realtime API. Calls land here either
// from the in-browser tester (Phase 1) or from Twilio Media Streams once
// telephony is wired (Phase 2). Every call is fully transcribed and
// summarized for compliance + clinic-owner review.
// ────────────────────────────────────────────────────────────────────────

enum VoiceCallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  TRANSFERRED
  ABANDONED
}

enum VoiceCallChannel {
  BROWSER // in-app voice test
  PHONE // real phone via Twilio
}

enum VoiceCallOutcome {
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  MESSAGE_TAKEN
  REFILL_REQUESTED
  INFO_PROVIDED
  TRANSFERRED_TO_HUMAN
  NO_ACTION
}

enum VoicePersona {
  WARM // friendly, conversational (default for primary care)
  PROFESSIONAL // clinical, concise (default for specialists)
  UPBEAT // energetic (default for wellness/aesthetics)
}

model VoiceAgentConfig {
  id                String       @id @default(cuid())
  clinicId          String       @unique
  enabled           Boolean      @default(false)
  greeting          String       @default("Hi! Thanks for calling. I'm an AI assistant who can help with booking, rescheduling, and answering questions about the clinic. How can I help you today?")
  persona           VoicePersona @default(WARM)
  voice             String       @default("alloy") // OpenAI Realtime voice: alloy, ash, ballad, coral, echo, sage, shimmer, verse
  businessHours     Json? // { mon: { open: "09:00", close: "17:00" }, ... }
  afterHoursMessage String       @default("We're closed right now. I can take a message and a staff member will get back to you on the next business day. Or, would you like to book online?")
  escalationPhone   String? // forward to human when needed
  capabilities      Json         @default("{\"book\":true,\"reschedule\":true,\"cancel\":true,\"refill\":true,\"messages\":true,\"transfer\":true,\"info\":true}")
  systemPromptExtra String? // clinic-specific instructions appended to system prompt
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model VoiceCall {
  id           String            @id @default(cuid())
  clinicId     String
  channel      VoiceCallChannel  @default(BROWSER)
  status       VoiceCallStatus   @default(IN_PROGRESS)
  outcome      VoiceCallOutcome?
  callerPhone  String?
  callerName   String?
  patientId    String?
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  durationSec  Int               @default(0)
  transcript   Json              @default("[]") // [{role, content, ts}, ...]
  summary      String?
  recordingUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  clinic Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  events VoiceCallEvent[]

  @@index([clinicId])
  @@index([status])
  @@index([startedAt])
  @@index([patientId])
}

model VoiceCallEvent {
  id           String   @id @default(cuid())
  callId       String
  type         String // "tool_call", "transfer", "error", "interrupt"
  toolName     String?
  argsJson     Json?
  resultJson   Json?
  errorMessage String?
  ts           DateTime @default(now())

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([type])
}

// --- COMPONENT 5: PRESCRIPTION → CART (B5) ---

/// Products the scribe detected in one visit, mapped to the clinic catalog and
/// waiting for the provider's explicit confirmation (B5.1 / B5.2).
model RxOrderProposal {
  id                String           @id @default(cuid())
  clinicId          String
  aiScribeSessionId String           @unique
  visitRecordId     String
  appointmentId     String
  patientId         String
  providerId        String
  status            RxProposalStatus @default(PENDING)
  confirmedById     String?
  confirmedAt       DateTime?
  cartId            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  clinic   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  session  AIScribeSession @relation(fields: [aiScribeSessionId], references: [id], onDelete: Cascade)
  provider Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  patient  User            @relation("RxProposalPatient", fields: [patientId], references: [id], onDelete: Restrict)
  lines    RxOrderLine[]

  @@index([clinicId])
  @@index([patientId])
}

/// One detected order. Every scribe order becomes exactly one line, so nothing
/// is dropped: unmatched text stays here as UNMAPPED / MANUAL.
model RxOrderLine {
  id               String         @id @default(cuid())
  clinicId         String
  proposalId       String
  /// The order as the scribe heard it. PHI: sealed by field-level encryption.
  rawText          String         @db.Text
  quantity         Int            @default(1)
  matchedProductId String?
  matchStatus      RxMatchStatus
  route            RxRoute
  decision         RxLineDecision @default(PENDING)
  position         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  proposal       RxOrderProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  matchedProduct Product?        @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  cartItem       CartItem?
  prescription   Prescription?

  @@index([clinicId])
  @@index([proposalId])
}

/// B5.4: the patient's card and shipping address on file, saved at booking.
/// The card itself stays at Stripe; only its id, brand and last 4 live here.
model PatientCommerceProfile {
  id                     String   @id @default(cuid())
  clinicId               String
  patientId              String
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  cardBrand              String?
  cardLast4              String?
  cardExpMonth           Int?
  cardExpYear            Int?
  shippingName           String?
  shippingLine1          String?
  shippingLine2          String?
  shippingCity           String?
  shippingState          String?
  shippingPostalCode     String?
  shippingCountry        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  clinic  Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient User   @relation("PatientCommerceProfiles", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, patientId])
  @@index([clinicId])
}
