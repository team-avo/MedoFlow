generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  SUPER_ADMIN
  PROVIDER
  FRONT_DESK
  ACCOUNTING
  MARKETING
  PATIENT
  STAFF
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum TenantPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum AppointmentStatus {
  DRAFT
  PENDING_PROVIDER_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentRequirementType {
  NONE
  DEPOSIT
  FULL
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum BookingSource {
  PUBLIC
  PATIENT_PORTAL
  FRONT_DESK
  PROVIDER
  WAITLIST
}

enum SlotHoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
}

enum VisitRecordStatus {
  DRAFT
  FINAL
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum FormScope {
  CLINIC
  DISCIPLINE
  SERVICE
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

enum AIScribeStatus {
  RECORDING
  TRANSCRIBING
  DRAFT_GENERATED
  EDITED
  APPROVED
  FAILED
}

enum ConsultationStatus {
  NOT_STARTED
  READY
  LIVE
  RECORDING
  ENDED
  PROCESSING
  TRANSCRIPT_READY
  FAILED
}

enum RecordingStatus {
  NOT_STARTED
  RECORDING
  STOPPED
  UPLOADING
  STORED
  FAILED
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum CartItemType {
  SERVICE
  PRODUCT
  PACKAGE
  MEMBERSHIP
}

enum ProductFulfillmentClass {
  SUPPLEMENT
  OTC
  AESTHETIC
  RX_NON_SCHEDULED
  RX_SCHEDULED
}

enum CartItemPatientDecision {
  PENDING
  ACCEPTED
  DECLINED
}

enum PrescriptionStatus {
  DRAFT
  PENDING_EPRESCRIBE
  SENT
}

enum RxProposalStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RxMatchStatus {
  MATCHED
  AMBIGUOUS
  UNMAPPED
}

enum RxRoute {
  CART
  EPRESCRIBE
  MANUAL
}

enum RxLineDecision {
  PENDING
  CONFIRMED
  REMOVED
}

enum PackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  INCOMPLETE
  PAST_DUE
  CANCELED
  ENDED
}

enum CommissionType {
  PERCENTAGE
  FLAT_RATE
}

enum CommissionItemType {
  ALL
  SERVICE
  PRODUCT
  PACKAGE
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

// ─── Multi-Tenancy: Tenant sits above Clinic ────────────────────────────────
// One Tenant = one SaaS customer account (may own multiple Clinics/locations)
// All clinic data is scoped through Clinic → Tenant
model Tenant {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  status                TenantStatus @default(TRIAL)
  plan                  TenantPlan   @default(FREE)
  region                String       @default("us-east-1")
  dataResidency         String?
  trialEndsAt           DateTime?
  onboardingStep        Int          @default(0)
  onboardingCompletedAt DateTime?
  termsAcceptedAt       DateTime?
  termsAcceptedByUserId String?
  termsVersion          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  clinics Clinic[]
  brand   Brand?

  @@index([slug])
  @@index([status])
}

model Brand {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  subdomain            String   @unique
  customDomain         String?  @unique
  customDomainVerified Boolean  @default(false)
  logoUrl              String?
  faviconUrl           String?
  primaryColor         String   @default("#6366f1")
  secondaryColor       String?
  typographyPair       String   @default("inter-inter")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([customDomain])
}

model Clinic {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  email            String
  slug             String?  @unique
  logoUrl          String?
  themeColor       String?
  subscriptionPlan String   @default("free")
  isActive         Boolean  @default(true)
  aiEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users                     User[]
  disciplines               Discipline[]
  providers                 Provider[]
  locations                 Location[]
  services                  Service[]
  appointments              Appointment[]
  visitRecords              VisitRecord[]
  prescriptions             Prescription[]
  auditLogs                 AuditLog[]
  waitlistEntries           WaitlistEntry[]
  slotHolds                 SlotHold[]
  payments                  Payment[]
  treatmentPlans            TreatmentPlan[]
  patientFiles              PatientFile[]
  formTemplates             FormTemplate[]
  formResponses             FormResponse[]
  invoices                  Invoice[]
  aiScribeSessions          AIScribeSession[]
  appointmentSeries         AppointmentSeries[]
  products                  Product[]
  inventoryItems            InventoryItem[]
  packages                  Package[]
  memberships               Membership[]
  patientMemberships        PatientClinicMembership[]
  googleCalendarConnections GoogleCalendarConnection[]
  googleCalendarEvents      GoogleCalendarEvent[]
  consultationSessions      ConsultationSession[]
  carts                     Cart[]
  commissionRules           CommissionRule[]
  commissionRecords         CommissionRecord[]
  customRoles               CustomRole[]
  scribeTemplates           ScribeTemplate[]
  sitePages                 SitePage[]
  voiceAgentConfig          VoiceAgentConfig?
  voiceCalls                VoiceCall[]
  breakGlassGrants          BreakGlassGrant[]
  rxOrderProposals          RxOrderProposal[]
  rxOrderLines              RxOrderLine[]
  patientCommerceProfiles   PatientCommerceProfile[]

  @@index([tenantId])
}

// Section-based clinic website ("Shopify for clinics"). Each clinic owns
// a small set of pages (Home, About, Services, Contact, etc.). The page
// body is a JSON array of typed sections rendered both in the dashboard
// editor and on the public route. draftSectionsJson is what the editor
// writes to; sectionsJson is what the public site renders. Publishing
// copies draft → published.
model SitePage {
  id                String         @id @default(cuid())
  clinicId          String
  slug              String
  title             String
  status            SitePageStatus @default(DRAFT)
  sectionsJson      Json           @default("[]")
  draftSectionsJson Json           @default("[]")
  seoTitle          String?
  seoDescription    String?
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, slug])
  @@index([clinicId])
  @@index([status])
}

enum SitePageStatus {
  DRAFT
  PUBLISHED
}

model CustomRole {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  isPreset    Boolean  @default(false)
  permissions Json // Array of permission keys: ["appointments.view", "billing.manage"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model User {
  id                 String    @id @default(cuid())
  clinicId           String?
  name               String
  email              String    @unique
  password           String
  role               Role
  customRoleId       String?
  permissions        Json?
  preferences        Json?
  hasSeenTour        Boolean   @default(false)
  tourCompletedAt    DateTime?
  isActive           Boolean   @default(true)
  hasSeenPatientTour Boolean   @default(false)
  // MFA (B0.2.2): TOTP secret is AES-256-GCM encrypted; recovery codes are sha256 hashes.
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  mfaPendingSecret   String?
  mfaEnrolledAt      DateTime?
  mfaRecoveryCodes   Json?
  mfaLastUsedStep    Int?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clinic                        Clinic?                    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  customRole                    CustomRole?                @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  provider                      Provider?
  passwordSetupTokens           PasswordSetupToken[]
  refreshTokens                 RefreshToken[]
  sessions                      UserSession[]
  breakGlassGrants              BreakGlassGrant[]
  appointments                  Appointment[]
  appointmentSeries             AppointmentSeries[]
  visitRecords                  VisitRecord[]
  prescriptions                 Prescription[]
  auditLogs                     AuditLog[]
  waitlistEntries               WaitlistEntry[]
  payments                      Payment[]
  visitNoteVersions             VisitNoteVersion[]
  treatmentPlans                TreatmentPlan[]            @relation("PatientPlans")
  patientFiles                  PatientFile[]              @relation("PatientFiles")
  uploadedFiles                 PatientFile[]              @relation("UploadedFiles")
  formResponses                 FormResponse[]
  invoices                      Invoice[]
  patientClinicMemberships      PatientClinicMembership[]  @relation("PatientClinicMemberships")
  googleCalendarConnections     GoogleCalendarConnection[]
  consultationSessionsAsPatient ConsultationSession[]
  carts                         Cart[]                     @relation("PatientCarts")
  patientPackages               PatientPackage[]           @relation("PatientPackages")
  patientSubscriptions          PatientSubscription[]      @relation("PatientSubscriptions")
  rxOrderProposals              RxOrderProposal[]          @relation("RxProposalPatient")
  commerceProfiles              PatientCommerceProfile[]   @relation("PatientCommerceProfiles")

  @@index([customRoleId])
}

model Discipline {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerDisciplines ProviderDiscipline[]
  services            Service[]
  treatmentPlans      TreatmentPlan[]
  formTemplates       FormTemplate[]

  @@unique([clinicId, name])
}

model ProviderDiscipline {
  id           String @id @default(cuid())
  providerId   String
  disciplineId String

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([providerId, disciplineId])
  @@index([providerId])
  @@index([disciplineId])
}

model Provider {
  id                  String     @id @default(cuid())
  clinicId            String
  userId              String?    @unique
  firstName           String
  lastName            String
  email               String?
  phone               String?
  bufferMinutes       Int        @default(0)
  bio                 String?
  headshotUrl         String?
  signatureUrl        String?
  licenseNumber       String?
  languages           String[]   @default([])
  scribeTemplateId    String?
  scribeTone          ScribeTone @default(CONCISE)
  scribeIncludeCoding Boolean    @default(true)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  clinic                 Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  disciplines            ProviderDiscipline[]
  user                   User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerServices       ProviderService[]
  appointments           Appointment[]
  visitRecords           VisitRecord[]
  prescriptions          Prescription[]
  providerAvailability   ProviderAvailability[]
  providerUnavailability ProviderUnavailability[]
  waitlistEntries        WaitlistEntry[]
  treatmentPlans         TreatmentPlan[]
  invoices               Invoice[]
  aiScribeSessions       AIScribeSession[]
  appointmentSeries      AppointmentSeries[]
  slotHolds              SlotHold[]
  locationAssignments    ProviderLocationAssignment[]
  googleCalendarEvents   GoogleCalendarEvent[]
  consultationSessions   ConsultationSession[]
  commissionRules        CommissionRule[]
  commissionRecords      CommissionRecord[]
  rxOrderProposals       RxOrderProposal[]
  prescribedCartItems    CartItem[]                   @relation("CartItemPrescribedBy")
  scribeTemplate         ScribeTemplate?              @relation(fields: [scribeTemplateId], references: [id], onDelete: SetNull)

  @@index([clinicId])
}

enum ScribeTone {
  CONCISE
  DETAILED
}

// Specialty-aware AI Scribe prompt template. Clinic-scoped so each clinic
// can fork the platform defaults, but the seed templates have clinicId=null
// to signal "system default" — those are visible to every clinic and cannot
// be edited by clinic admins (only the platform admin can).
model ScribeTemplate {
  id           String   @id @default(cuid())
  clinicId     String?
  specialty    String
  name         String
  description  String?
  systemPrompt String   @db.Text
  outputSchema Json?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic    Clinic?    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providers Provider[]

  @@index([clinicId])
  @@index([specialty])
}

model ProviderLocationAssignment {
  id         String   @id @default(cuid())
  providerId String
  locationId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([providerId, locationId])
  @@index([locationId])
  @@index([providerId, isPrimary])
}

model ProviderAvailability {
  id         String   @id @default(cuid())
  providerId String
  locationId String?
  weekday    Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model ProviderUnavailability {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime
  startTime  String?
  endTime    String?
  reason     String?
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([date])
}

model Location {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  address      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  timezone     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic              Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  slotHolds           SlotHold[]
  providerAssignments ProviderLocationAssignment[]
  patientMemberships  PatientClinicMembership[]    @relation("PatientMembershipPrimaryLocation")

  @@unique([clinicId, name])
}

model PatientClinicMembership {
  id                String   @id @default(cuid())
  clinicId          String
  patientId         String
  primaryLocationId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         User      @relation("PatientClinicMemberships", fields: [patientId], references: [id], onDelete: Restrict)
  primaryLocation Location? @relation("PatientMembershipPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)

  @@unique([clinicId, patientId])
  @@index([patientId])
  @@index([clinicId, isActive])
}

model SlotHold {
  id                       String         @id @default(cuid())
  clinicId                 String
  providerId               String
  serviceId                String
  locationId               String?
  timezone                 String         @default("UTC")
  startTime                DateTime
  endTime                  DateTime
  patientId                String?
  expiresAt                DateTime
  status                   SlotHoldStatus @default(ACTIVE)
  bookingSource            BookingSource  @default(PUBLIC)
  releasedAt               DateTime?
  expiredAt                DateTime?
  convertedToAppointmentId String?
  createdAt                DateTime       @default(now())

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([expiresAt])
  @@index([providerId, startTime])
}

model Service {
  id                      String   @id @default(cuid())
  clinicId                String
  disciplineId            String
  name                    String
  duration                Int
  defaultPrice            Decimal  @db.Decimal(10, 2)
  taxApplicable           Boolean  @default(false)
  minimumNoticeMinutes    Int?     @default(0)
  maxFutureBookingDays    Int?     @default(365)
  cancellationWindowHours Int?     @default(0)
  cancellationFeeType     String?  @default("NONE")
  cancellationFeeValue    Decimal? @db.Decimal(10, 2)
  prepaymentType          String   @default("NONE") // NONE, DEPOSIT, FULL
  depositAmount           Decimal? @db.Decimal(10, 2)
  requirePrepayment       Boolean  @default(false)
  requireProviderApproval Boolean  @default(false)
  isActive                Boolean  @default(true)
  isArchived              Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  clinic              Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  discipline          Discipline          @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  providerServices    ProviderService[]
  appointments        Appointment[]
  appointmentSeries   AppointmentSeries[]
  waitlistEntries     WaitlistEntry[]
  slotHolds           SlotHold[]
  formTemplates       FormTemplate[]
  invoiceItems        InvoiceItem[]
  cartItems           CartItem[]
  commissionRules     CommissionRule[]
  recommendedProducts Product[]           @relation("ServiceRecommendations")

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([disciplineId])
}

model ProviderService {
  id            String   @id @default(cuid())
  providerId    String
  serviceId     String
  priceOverride Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
}

model Invoice {
  id              String        @id @default(cuid())
  clinicId        String
  locationId      String?
  appointmentId   String?
  patientId       String
  providerId      String?
  stripeInvoiceId String?
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @db.Decimal(10, 2)
  taxAmount       Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient           User               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider          Provider?          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  items             InvoiceItem[]
  payments          Payment[]
  commissionRecords CommissionRecord[]

  @@unique([stripeInvoiceId])
  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  serviceId    String?
  disciplineId String?
  providerId   String?
  description  String
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  totalPrice   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  productId         String?
  packageId         String?
  membershipId      String?
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  package           Package?           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  membership        Membership?        @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  commissionRecords CommissionRecord[]

  @@index([invoiceId])
  @@index([serviceId])
  @@index([productId])
  @@index([packageId])
  @@index([membershipId])
}

/// B1.1: the database refuses overlapping live appointments for a provider
/// (exclusion constraint "Appointment_provider_no_overlap", btree_gist) and
/// appointments that end before they start ("Appointment_time_order").
/// Prisma cannot express these; they live in migration
/// 20261014000000_appointment_no_overlap. Keep that migration's status list
/// in sync with ACTIVE_APPOINTMENT_STATUSES in appointmentService.ts.
model Appointment {
  id                       String                 @id @default(cuid())
  clinicId                 String
  locationId               String?
  providerId               String
  serviceId                String
  disciplineId             String?
  patientId                String
  timezone                 String                 @default("UTC")
  startTime                DateTime
  endTime                  DateTime
  status                   AppointmentStatus      @default(CONFIRMED)
  priceAtBooking           Decimal                @db.Decimal(10, 2)
  paymentStatus            PaymentStatus          @default(NONE)
  paymentRequirementType   PaymentRequirementType @default(NONE)
  approvalStatus           ApprovalStatus         @default(NOT_REQUIRED)
  bookingSource            BookingSource          @default(PUBLIC)
  depositAmount            Decimal?               @db.Decimal(10, 2)
  paymentDueAt             DateTime?
  slotHeldUntil            DateTime?
  bookingHoldExpiresAt     DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  notes                    String?                @db.Text
  createdById              String?
  updatedById              String?
  reminderSent             Boolean                @default(false)
  recurringSeriesId        String?
  rescheduledFromId        String?                @unique
  rescheduledToId          String?
  meetLink                 String?
  /**
   * Booking-time AI-Scribe consent. When set, the patient opted in to
   * automated note-taking while booking. The ConsultationSession created for
   * this appointment will start with consentStatus=GRANTED so the provider
   * doesn't need to re-prompt mid-visit.
   */
  aiScribeConsentGrantedAt DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  provider        Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  patient         User               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recurringSeries AppointmentSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)

  rescheduledFrom Appointment? @relation("RescheduleFrom", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment? @relation("RescheduleFrom")

  visitRecords         VisitRecord[]
  prescriptions        Prescription[]
  payments             Payment[]
  formResponses        FormResponse[]
  invoices             Invoice[]
  consultationSessions ConsultationSession[]
  cartItem             CartItem?
  packageSessionUsages PackageSessionUsage[]

  @@index([providerId])
  @@index([patientId])
  @@index([clinicId])
  @@index([locationId])
  @@index([startTime])
  @@index([status])
  @@index([providerId, startTime])
  @@index([clinicId, startTime])
  @@index([patientId, startTime])
  @@index([recurringSeriesId])
}

model Payment {
  id                    String        @id @default(cuid())
  clinicId              String
  providerId            String?
  invoiceId             String?
  appointmentId         String?
  patientId             String
  refundForPaymentId    String?
  stripePaymentIntentId String?       @unique
  stripeRefundId        String?       @unique
  stripeClientSecret    String?
  paymentChannel        String?
  paymentMethod         String?
  recordedById          String?
  recordedAt            DateTime?
  notes                 String?
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User         @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([appointmentId])
  @@index([status])
  @@index([refundForPaymentId])
}

model Product {
