PORT=3001
NODE_ENV=development
PRISMA_HIDE_UPDATE_MESSAGE=true

# ─── Database ───────────────────────────────────────────────────────────────
# The app connects as the non-owner medoflow_app role so Postgres RLS applies
# (B0.1.3). Migrations / seeds / audit purge use the owner role.
DATABASE_URL="postgresql://medoflow_app:password@localhost:5432/medoflow?schema=public"
MIGRATION_DATABASE_URL="postgresql://owner:password@localhost:5432/medoflow?schema=public"
AUDIT_PURGE_DATABASE_URL="postgresql://owner:password@localhost:5432/medoflow?schema=public"

# ─── Tenant isolation / audit (B0.1, B0.3) ──────────────────────────────────
# enforce is the default; production refuses to boot otherwise.
TENANT_ISOLATION_MODE=enforce
TENANT_RLS=on
AUDIT_RETENTION_YEARS=6

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. In development, localhost is allowed when unset.
CORS_ORIGIN=http://localhost:3000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required: openssl rand -hex 32 (boot rejects short / placeholder / low-entropy values)
JWT_SECRET=
# Only during a rotation window (docs/SECRETS_AND_ROTATION.md)
# JWT_SECRET_PREVIOUS=
# 64 hex chars — encrypts staff TOTP secrets (B0.2.2)
MFA_ENCRYPTION_KEY=

# ─── Field-level encryption (B3.2, docs/adr/0002-field-level-encryption.md) ──
# Seals transcripts, SOAP notes (+ versions) and intake answers. Required in
# production. After first setting a key, run: pnpm run ops:encrypt-phi
# Provider: env (keys below) | aws-kms (KMS-wrapped data keys)
FIELD_ENCRYPTION_PROVIDER=env
# env: comma-separated <kid>:<64 hex> — generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEYS=
# Key that seals new values (others stay readable for rotation)
FIELD_ENCRYPTION_ACTIVE_KID=
# aws-kms: <kid>:<base64 CiphertextBlob> from `aws kms generate-data-key`
# FIELD_ENCRYPTION_KMS_WRAPPED_KEYS=
# FIELD_ENCRYPTION_KMS_KEY_ID=
# FIELD_ENCRYPTION_KMS_REGION=
# Server-side idle logoff (B0.2.3)
SESSION_IDLE_TIMEOUT_MINUTES=15
# Refresh cookie SameSite (F0.2.3): lax in development; production defaults to none
# (Secure + Partitioned) while app/API are cross-site, strict once they share a domain.
# REFRESH_COOKIE_SAMESITE=lax
# BREAK_GLASS_MAX_MINUTES=60
# AUTH_RATE_LIMIT_MAX=5

# ─── Security alerts (B0.6.5) ────────────────────────────────────────────────
# Slack-compatible incoming webhook; payloads carry ids and counts only.
ALERT_WEBHOOK_URL=
# ALERT_WINDOW_MINUTES=5
# ALERT_FAILED_LOGIN_THRESHOLD=25
# ALERT_FAILED_LOGIN_PER_IP_THRESHOLD=10
# ALERT_RECORD_ACCESS_THRESHOLD=50
FRONTEND_URL=http://localhost:3000

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Redis (BullMQ) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medoflow.com

# ─── AI Front Desk (voice agent) ─────────────────────────────────────────────
# Groq powers the whole voice agent: speech-to-text, the reasoning/tool-calling
# model, call summaries, AND text-to-speech. This is the ONLY AI key required.
# Generate a free one (no card): https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# One-time setup: the TTS model needs org-admin terms acceptance at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Until then the agent still works — it just falls back to the browser voice.

# Optional voice tuning (sensible defaults are built in)
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_VOICE_WARM=hannah
# GROQ_VOICE_PROFESSIONAL=troy
# GROQ_VOICE_UPBEAT=austin

# Optional TTS fallback — only used if Groq TTS fails. Safe to leave unset.
# GEMINI_API_KEY=AIza...

# ─── AI Scribe ───────────────────────────────────────────────────────────────
# Runs entirely on self-hosted models — no API key needed.
# Requires: Ollama running locally (https://ollama.com) + Redis for the job queue.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Whisper model size (tiny|base|small|medium|large) — local transcription
WHISPER_MODEL_SIZE=small.en

# Optional — only for the legacy OpenAI Realtime voice path (superseded by Groq).
# Not needed for normal operation.
# OPENAI_API_KEY=sk-...

# ─── File Storage (S3 / R2 / MinIO) — B3.1 ───────────────────────────────────
# When both keys are set, object storage is used; otherwise the local uploads/
# directory (development only — production refuses to boot without S3_* keys).
# Patient files are reached ONLY through presigned URLs: the browser PUTs/GETs
# the bucket directly, so the bucket needs a CORS rule allowing PUT + GET from
# the frontend origin (see the Component 3 walkthrough).
FILE_SIZE_LIMIT_MB=10
# Presigned URL lifetime in seconds (default 300, capped at 900)
# FILE_URL_TTL_SECONDS=300
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=medoflow-files
# Optional separate bucket for patient files (defaults to S3_BUCKET)
# S3_FILES_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# Server-side encryption on every write: AES256 (default) | aws:kms | provider-default
# (provider-default for Cloudflare R2, which always encrypts at rest and rejects the header)
# S3_SSE=AES256
# S3_SSE_KMS_KEY_ID=
# Local development only: HMAC key for the local presigned-URL stand-in
# (random per process when unset)
# FILE_BLOB_SIGNING_SECRET=

# ─── Google Calendar / Meet ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte hex key — generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ─── Daily.co (video consultations, optional fallback) ─────────────────────
DAILY_API_KEY=

# ─── Jitsi as a Service (video consultations, current default) ──────────────
# Sign up at https://jaas.8x8.vc, create an API key, then paste:
#   JAAS_APP_ID       = the "vpaas-magic-cookie-..." string
#   JAAS_KID          = API Key ID shown next to your key
#   JAAS_PRIVATE_KEY       = the RSA private key (PEM). Replace real
#                            newlines with literal \n — we restore them
#                            before signing. Example:
#   JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#   JAAS_PRIVATE_KEY_PATH  = ALTERNATIVE to JAAS_PRIVATE_KEY: a file path
#                            to the PEM. Nicer for dev — no newline mangling.
#                            Example: ./secrets/jaas-private.pem
# Without these, the video room endpoint will return domain=meet.jit.si with
# an empty JWT — meet.jit.si's public server currently gates rooms behind a
# Google/Microsoft moderator log-in, so set these to actually join calls.
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=
JAAS_PRIVATE_KEY_PATH=

# ─── App URL aliases ─────────────────────────────────────────────────────────
# Fallback for links in emails when FRONTEND_URL is not set
APP_URL=http://localhost:3000
