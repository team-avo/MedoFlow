{
  "name": "medoflow",
  "version": "0.0.0",
  "private": true,
  "description": "MedoFlow — multi-tenant SaaS clinic-management platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "source-map-js": "^1.2.2",
      "fast-xml-builder": "^1.3.1",
      "ip-address": "^10.7.4",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
